{
  "name": "landing-taller",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "ADJUNTOS", "bucket_name": "mecalab-adjuntos" }
  ],
  "ratelimits": [
    { "name": "LIMITADOR", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ]
}
